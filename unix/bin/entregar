#!/usr/bin/env bash
# entregar - Empaqueta el proyecto en un ZIP de entrega y publica opcionalmente a GitHub
# Compatible con macOS y Linux.
# Uso: entregar [directorio_del_proyecto]

set -eu

RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; CYAN='\033[36m'; RESET='\033[0m'

PROJ_DIR="${1:-.}"
if [ ! -d "$PROJ_DIR" ]; then
    echo -e "${RED}[ERROR] No existe el directorio '$PROJ_DIR'.${RESET}"
    exit 1
fi

cd "$PROJ_DIR"
if ! ls ./*.c >/dev/null 2>&1 && [ ! -f "Makefile" ]; then
    echo -e "${RED}[ERROR] El directorio no contiene archivos .c ni Makefile.${RESET}"
    exit 1
fi

BASENAME="$(basename "$(pwd)")"

# 1. Compilar antes de entregar
if [ -f "Makefile" ]; then
    printf "%b¿Compilar el proyecto antes de empaquetar? (S/n): ${RESET}" "${CYAN}"
    read -r answer || answer="s"
    if ! printf '%s' "$answer" | grep -qi '^n'; then
        echo -e "${CYAN}-> Compilando...${RESET}"
        if ! make >/dev/null; then
            echo -e "${RED}[ERROR] La compilación falló. Corregí los errores antes de entregar.${RESET}"
            exit 1
        fi
        echo -e "${GREEN}[OK] Compiló sin errores.${RESET}"
    fi
fi

# 2. Ejecutar verificaciones si existen casos de prueba
if [ -d "tests" ] && ls tests/caso_*.in >/dev/null 2>&1; then
    echo ""
    echo -e "${CYAN}-> Ejecutando verificador local ...${RESET}"
    if command -v verificar >/dev/null 2>&1; then
        if ! verificar .; then
            printf "%bLas pruebas no pasaron. ¿Deseás continuar y generar el archivo igualmente? (s/N): ${RESET}" "${YELLOW}"
            read -r ans || ans="n"
            if ! printf '%s' "$ans" | grep -qi '^s'; then
                echo -e "${RED}[CANCELADO] Entrega abortada por el usuario.${RESET}"
                exit 1
            fi
        fi
    fi
fi

# 3. Generar ZIP limpio de entrega
OUT="../ENTREGA_${BASENAME}_$(date +%Y%m%d-%H%M).zip"

PYBIN="$(command -v python3 || command -v python || true)"
if [ -z "$PYBIN" ]; then
    echo -e "${RED}[ERROR] Python no está disponible para crear el archivo ZIP.${RESET}"
    exit 1
fi

"$PYBIN" - "$OUT" <<'PY_EOF'
import os
import sys
import zipfile

out = sys.argv[1]
exclude_dirs = {".git", "build", ".vscode", ".idea"}
exclude_ext = (".o", ".exe", ".zip", ".dll", ".so", ".dylib", ".out", ".out_got")

with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
    count = 0
    for root, dirs, files in os.walk("."):
        dirs[:] = [d for d in dirs if d not in exclude_dirs and not d.endswith(".dSYM")]
        for f in files:
            if f.endswith(exclude_ext) or f == ".DS_Store":
                continue
            path = os.path.join(root, f)
            z.write(path, os.path.relpath(path, "."))
            count += 1
print(f"[OK] {count} archivos empaquetados en la entrega.")
PY_EOF

echo -e "${GREEN}[ÉXITO] Archivo generado: ${OUT}${RESET}"

# 4. Publicación opcional vía Git si es un repositorio remoto
if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git remote get-url origin >/dev/null 2>&1; then
    echo ""
    if [ -z "$(git status --porcelain)" ]; then
        echo -e "${CYAN}[INFO] El repositorio de Git no tiene cambios pendientes de subir.${RESET}"
    else
        printf "%b¿Publicar cambios al repositorio remoto en GitHub (commit y push)? (s/N): ${RESET}" "${CYAN}"
        read -r answer || answer="n"
        if printf '%s' "$answer" | grep -qi '^s'; then
            BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo main)"
            git add -A
            if git commit -m "Entrega $BASENAME $(date '+%Y-%m-%d %H:%M')"; then
                if git push -u origin "$BRANCH"; then
                    echo -e "${GREEN}[ÉXITO] Cambios subidos a la rama $BRANCH.${RESET}"
                else
                    echo -e "${RED}[ERROR] Falló el push. Revisá tus credenciales con 'gh auth login'.${RESET}"
                fi
            fi
        fi
    fi
fi
