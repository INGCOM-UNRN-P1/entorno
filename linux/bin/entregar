#!/usr/bin/env bash
# entregar - Empaqueta el proyecto actual en un ZIP de entrega para la cátedra.
# Compila el proyecto (si tiene Makefile) y empaqueta solo fuentes, excluyendo
# binarios, objetos, builds y metadatos. Funciona en Windows (MSYS2) y Linux.
#
# Uso: entregar [directorio_del_proyecto]   (por defecto, el directorio actual)

set -eu

RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; CYAN='\033[36m'; RESET='\033[0m'

identity_ok() {
    [ -n "$(git config user.name 2>/dev/null)" ] && [ -n "$(git config user.email 2>/dev/null)" ]
}

PROJ_DIR="${1:-.}"
if [ ! -d "$PROJ_DIR" ]; then
    echo -e "${RED}[ERROR] No existe el directorio '$PROJ_DIR'.${RESET}"
    exit 1
fi

cd "$PROJ_DIR"
if ! ls ./*.c >/dev/null 2>&1 && [ ! -f "Makefile" ]; then
    echo -e "${RED}[ERROR] El directorio no parece un proyecto C (no hay archivos .c ni Makefile).${RESET}"
    exit 1
fi

BASENAME="$(basename "$(pwd)")"

# Validación de compilación antes de empacar
if [ -f "Makefile" ]; then
    printf "%b¿Compilar el proyecto antes de empacar? (recomendado) (S/n): ${RESET}" "${CYAN}"
    read -r answer || answer="s"
    if ! printf '%s' "$answer" | grep -qi '^n'; then
        echo -e "${CYAN}-> Compilando...${RESET}"
        if ! make >/dev/null; then
            echo -e "${RED}[ERROR] La compilación falló. Corregí los errores antes de entregar.${RESET}"
            exit 1
        fi
        echo -e "${GREEN}[OK] Compila sin errores.${RESET}"
    fi
fi

# Corrector local: las pruebas de cátedra deben pasar antes de empacar
if [ -n "$(ls tests/caso_*.in 2>/dev/null)" ] \
   || { [ -f "Makefile" ] && grep -qE '^[[:space:]]*(test|check)[[:space:]]*:' Makefile; }; then
    echo ""
    echo -e "${CYAN}-> Ejecutando el corrector local (verificar)...${RESET}"
    VERIF="$(command -v verificar || echo "$(dirname "$0")/verificar")"
    if ! bash "$VERIF" .; then
        printf "%bLas pruebas no pasan. ¿Empacar la entrega igualmente? (s/N): ${RESET}" "${YELLOW}"
        read -r answer || answer="n"
        if ! printf '%s' "$answer" | grep -qi '^s'; then
            echo -e "${RED}[ENTREGA CANCELADA] Corregí los casos que fallan y volvé a intentar.${RESET}"
            exit 1
        fi
        echo -e "${YELLOW}[AVISO] Empacando con pruebas fallidas, bajo tu responsabilidad.${RESET}"
    fi
fi

# Pre-validación estricta con el motor Ripley (proyectos con manifiesto ripley.toml/.ripkg)
RIPLEY_BIN="$(command -v ripley 2>/dev/null || true)"
if [ -z "$RIPLEY_BIN" ] && [ -n "${PORTABLE_ROOT:-}" ] && [ -x "$PORTABLE_ROOT/bin/ripley" ]; then
    RIPLEY_BIN="$PORTABLE_ROOT/bin/ripley"
fi
if { ls ./*.ripkg >/dev/null 2>&1 || [ -f "ripley.toml" ]; } && [ -n "$RIPLEY_BIN" ]; then
    echo ""
    echo -e "${CYAN}-> Pre-validación con el motor Ripley (modo estricto)...${RESET}"
    if ! "$RIPLEY_BIN" check . --strict; then
        printf "%bRipley detectó observaciones. ¿Empacar la entrega igualmente? (s/N): ${RESET}" "${YELLOW}"
        read -r answer || answer="n"
        if ! printf '%s' "$answer" | grep -qi '^s'; then
            echo -e "${RED}[ENTREGA CANCELADA] Atendé las observaciones del análisis y volvé a intentar.${RESET}"
            exit 1
        fi
        echo -e "${YELLOW}[AVISO] Empacando con observaciones de Ripley, bajo tu responsabilidad.${RESET}"
    fi
fi

OUT="../ENTREGA_${BASENAME}_$(date +%Y%m%d-%H%M).zip"

PYBIN="$(command -v python3 || command -v python || true)"
if [ -z "$PYBIN" ]; then
    echo -e "${RED}[ERROR] Se necesita Python para crear el ZIP y no está disponible.${RESET}"
    exit 1
fi

"$PYBIN" - "$OUT" <<'EOF'
import os
import sys
import zipfile

out = sys.argv[1]
exclude_dirs = {".git", "build"}
exclude_ext = (".o", ".exe", ".zip", ".dll")

with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
    count = 0
    for root, dirs, files in os.walk("."):
        dirs[:] = [d for d in dirs if d not in exclude_dirs]
        for f in files:
            if f.endswith(exclude_ext):
                continue
            path = os.path.join(root, f)
            z.write(path, os.path.relpath(path, "."))
            count += 1
print(f"[OK] {count} archivos empaquetados")
EOF

echo -e "${GREEN}[ÉXITO] Entrega generada: ${OUT}${RESET}"
echo "Recordá verificar su contenido antes de enviarla."

# --- Publicación opcional en el repositorio remoto (flujo GitHub Classroom) ---
if git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
   && git remote get-url origin >/dev/null 2>&1; then
    echo ""
    if [ -z "$(git status --porcelain)" ]; then
        echo -e "${CYAN}[INFO] El repositorio no tiene cambios sin publicar.${RESET}"
    else
        printf "%b¿Publicar los cambios al repositorio remoto (commit + push)? (s/N): ${RESET}" "${CYAN}"
        read -r answer || answer="n"
        if printf '%s' "$answer" | grep -qi '^s'; then
            BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo main)"
            if ! identity_ok; then
                echo -e "${RED}[ERROR] Falta identidad de Git. Ejecutá configure-git.sh y volvé a intentar.${RESET}"
                exit 1
            fi
            git add -A
            if git commit -m "Entrega $BASENAME $(date '+%Y-%m-%d %H:%M')"; then
                if git push -u origin "$BRANCH"; then
                    echo -e "${GREEN}[ÉXITO] Cambios publicados en origin/$BRANCH.${RESET}"
                else
                    echo -e "${RED}[ERROR] Falló el push. Revisá credenciales con configure-git.sh.${RESET}"
                    exit 1
                fi
            else
                echo -e "${YELLOW}[AVISO] No se pudo crear el commit (¿nada en staging?).${RESET}"
            fi
        else
            echo -e "${CYAN}[INFO] Publicación omitida: solo se generó el ZIP local.${RESET}"
        fi
    fi
fi
