#!/usr/bin/env bash
# nuevo-proyecto - Crea la estructura inicial de un proyecto de Programación 1.
# Funciona en el terminal portable de Windows (MSYS2) y en la variante Linux.
# Incluye depuración lista para usar (F5 con GDB en VS Code), formato automático
# (.clang-format) y convenciones de editor (.editorconfig).
#
# Uso: nuevo-proyecto <nombre>

set -eu

RED='\033[31m'; GREEN='\033[32m'; CYAN='\033[36m'; RESET='\033[0m'

if [ "${1:-}" = "" ]; then
    echo -e "${RED}[ERROR] Falta el nombre del proyecto.${RESET}"
    echo "Uso: nuevo-proyecto <nombre>"
    exit 1
fi

NAME="$1"
if ! printf '%s' "$NAME" | grep -qE '^[a-zA-Z0-9_][a-zA-Z0-9_-]*$'; then
    echo -e "${RED}[ERROR] Nombre inválido: usá letras, números, guiones y guión bajo.${RESET}"
    exit 1
fi

if [ -e "$NAME" ]; then
    echo -e "${RED}[ERROR] Ya existe un archivo o carpeta llamado '$NAME'.${RESET}"
    exit 1
fi

mkdir -p "$NAME/.vscode"

# main.c de punto de partida (placeholder __NOMBRE__ reemplazado abajo)
cat > "$NAME/main.c" <<'EOF'
#include <stdio.h>

/* Proyecto: __NOMBRE__
 * Depuración: abrí este proyecto en VS Code y presioná F5.
 */
int main(void) {
    printf("Hola desde __NOMBRE__!\n");
    return 0;
}
EOF
sed -i "s/__NOMBRE__/$NAME/g" "$NAME/main.c"

cat > "$NAME/Makefile" <<'EOF'
# Makefile de cátedra - Programación 1
CC      ?= gcc
CFLAGS  ?= -O2 -g -Wall -std=c11
TARGET  := __NOMBRE__

all: $(TARGET)

$(TARGET): main.c
	$(CC) $(CFLAGS) -o $@ $<

clean:
	rm -f $(TARGET) $(TARGET).exe *.o

.PHONY: all clean
EOF
sed -i "s/__NOMBRE__/$NAME/g" "$NAME/Makefile"

cat > "$NAME/.gitignore" <<'EOF'
# Binarios generados
__NOMBRE__
__NOMBRE__.exe
*.o
build/
.vs/
EOF
sed -i "s/__NOMBRE__/$NAME/g" "$NAME/.gitignore"

# --- Tarea de compilación por defecto (Ctrl+Shift+B) ---
cat > "$NAME/.vscode/tasks.json" <<'EOF'
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compilar",
            "type": "shell",
            "command": "make",
            "args": [],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "detail": "Compila el proyecto usando el Makefile de cátedra"
        }
    ]
}
EOF

# --- Configuración de depuración F5 (variante según plataforma del entorno) ---
if [ -n "${MSYSTEM:-}" ]; then
    # Entorno portable Windows: GDB vive dentro del árbol UCRT64 del entorno
    cat > "$NAME/.vscode/launch.json" <<EOF
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Depurar",
            "type": "cppdbg",
            "request": "launch",
            "program": "\${workspaceFolder}/$NAME.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "\${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "\${env:PORTABLE_ROOT}/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "compilar"
        }
    ]
}
EOF
else
    # Linux: GDB del sistema se resuelve desde el PATH
    cat > "$NAME/.vscode/launch.json" <<EOF
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Depurar",
            "type": "cppdbg",
            "request": "launch",
            "program": "\${workspaceFolder}/$NAME",
            "args": [],
            "stopAtEntry": false,
            "cwd": "\${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "compilar"
        }
    ]
}
EOF
fi

# --- Formato automático de código ---
cat > "$NAME/.clang-format" <<'EOF'
---
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
AlignConsecutiveMacros: Consecutive
AllowShortFunctionsOnASingleLine: None
SortIncludes: CaseSensitive
EOF

# --- Convenciones de editor ---
cat > "$NAME/.editorconfig" <<'EOF'
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
EOF

# --- Pruebas de cátedra: corrector local (verificar) ---
mkdir -p "$NAME/tests"
: > "$NAME/tests/caso_01.in"
printf 'Hola desde %s!\n' "$NAME" > "$NAME/tests/caso_01.out"

echo -e "${GREEN}[ÉXITO] Proyecto '$NAME' creado con depuración lista (F5).${RESET}"
echo "Estructura:"
echo "  $NAME/"
echo "  ├── main.c              (hola mundo listo para compilar)"
echo "  ├── Makefile            (make / mingw32-make, con símbolos -g)"
echo "  ├── tests/              (caso_01 del corrector: ejecutá verificar)"
echo "  ├── .gitignore"
echo "  ├── .clang-format       (Shift+Alt+F formatea el código)"
echo "  ├── .editorconfig"
echo "  └── .vscode/            (F5 compila y depura con GDB)"
echo ""
echo -e "${CYAN}Siguiente paso sugerido:${RESET} cd $NAME && verificar   # corre las pruebas de cátedra"
